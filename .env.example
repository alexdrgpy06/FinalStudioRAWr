# ====================================
# AutoStudio Environment Configuration
# ====================================
# Copy this file to .env and configure according to your environment
# DO NOT commit the .env file to version control!

# ====================================
# Backend Configuration
# ====================================

# Database URL (SQLite by default, can use PostgreSQL for production)
DATABASE_URL=sqlite:///./autostudio.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/autostudio

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# File Upload Limits (in MB)
MAX_LOGO_SIZE_MB=10
MAX_XMP_SIZE_MB=50

# ====================================
# Edge Agent Configuration
# ====================================

# Backend API URL
API_URL=http://127.0.0.1:8000

# Folder Paths
INBOX_DIR=./inbox
OUT_DIR=./out
PROCESSED_DIR=./processed

# Polling Intervals (in seconds)
EVENT_POLL_INTERVAL=10
INBOX_SCAN_INTERVAL=30

# Debug Mode (set to True to keep RAW files in inbox for testing)
DEBUG_XMP=False

# RawTherapee CLI Path (leave empty for auto-detection)
RAWTHERAPEE_PATH="C:\Program Files\RawTherapee\5.12\rawtherapee-cli.exe"

# ====================================
# Frontend Configuration
# ====================================

# API URL for frontend (automatically set by Vite)
VITE_API_URL=http://127.0.0.1:8000

# ====================================
# General Configuration
# ====================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
