{
    "version": 1,
    "id": "vintage_v1",
    "name": "Vintage",
    "description": "Look analógico suave. Colores apagados, negros levantados y dominante cálida envejecida.",
    "pipeline": [
        {
            "type": "tone_curve",
            "params": {
                "contrast": 0.02,
                "black_lift": 0.14,
                "highlight_rolloff": 0.10
            }
        },
        {
            "type": "color_grade",
            "params": {
                "temp_shift": 120,
                "tint_shift": -4,
                "sat": 0.75
            }
        }
    ]
}