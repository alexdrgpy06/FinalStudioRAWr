{
    "version": 1,
    "id": "moody_v2",
    "name": "Moody",
    "description": "Editorial moody con contraste controlado, colores contenidos y piel natural. Cinemático, no frío.",
    "pipeline": [
        {
            "type": "tone_curve",
            "params": {
                "contrast": 0.16,
                "black_lift": 0.06,
                "highlight_rolloff": 0.22
            }
        },
        {
            "type": "color_grade",
            "params": {
                "temp_shift": -40,
                "tint_shift": 6,
                "sat": 0.82
            }
        },
        {
            "type": "local_contrast",
            "params": {
                "amount": 0.08
            }
        }
    ]
}